{
  "annotations": {"list": []},
  "description": "Diagnóstico unificado de salud, métricas, logs y trazas por microservicio.",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {"title": "Volver a Operación de Plataforma", "type": "link", "url": "/d/rhm-platform-overview/rhm-operacion-de-plataforma?orgId=1", "targetBlank": false},
    {"title": "Abrir en Jaeger", "type": "link", "url": "http://localhost:16686/search?service=$service&lookback=1h&limit=20", "targetBlank": true},
    {"title": "Prometheus", "type": "link", "url": "http://localhost:9090", "targetBlank": true}
  ],
  "panels": [
    {
      "id": 1, "type": "row", "title": "Resumen de $service",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "collapsed": false, "panels": []
    },
    {
      "id": 2, "type": "stat", "title": "Estado funcional",
      "description": "Resultado de /health, incluida la base de datos y las dependencias críticas.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 1},
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "NO DISPONIBLE", "color": "red"}, "1": {"text": "DISPONIBLE", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"refId": "A", "expr": "probe_success{job=\"service-health\",service=\"$service\"}", "instant": true, "range": false}]
    },
    {
      "id": 3, "type": "stat", "title": "Respuesta de /health",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 4, "x": 4, "y": 1},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "mappings": [{"type": "value", "options": {"200": {"text": "HTTP 200", "color": "green"}, "503": {"text": "HTTP 503", "color": "red"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 200}, {"color": "red", "value": 300}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"refId": "A", "expr": "probe_http_status_code{job=\"service-health\",service=\"$service\"}", "instant": true, "range": false}]
    },
    {
      "id": 4, "type": "stat", "title": "Tiempo del health check",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 4, "x": 8, "y": 1},
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 3, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 3}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"refId": "A", "expr": "probe_duration_seconds{job=\"service-health\",service=\"$service\"}", "instant": true, "range": false}]
    },
    {
      "id": 5, "type": "gauge", "title": "Disponibilidad en el período",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 1},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "decimals": 2, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 95}, {"color": "green", "value": 99}]}}, "overrides": []},
      "options": {"orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true, "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"refId": "A", "expr": "100 * avg_over_time(probe_success{job=\"service-health\",service=\"$service\"}[$__range])", "instant": true, "range": false}]
    },
    {
      "id": 6, "type": "stat", "title": "Alertas activas",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 1},
      "fieldConfig": {"defaults": {"decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"refId": "A", "expr": "count(ALERTS{alertstate=\"firing\",service=\"$service\"}) or vector(0)", "instant": true, "range": false}]
    },
    {
      "id": 7, "type": "row", "title": "Salud y tráfico",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 6}, "collapsed": false, "panels": []
    },
    {
      "id": 8, "type": "state-timeline", "title": "Historial de disponibilidad",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 7},
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "NO DISPONIBLE", "color": "red"}, "1": {"text": "DISPONIBLE", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"alignValue": "center", "mergeValues": true, "rowHeight": 0.9, "showValue": "auto", "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [{"refId": "A", "expr": "probe_success{job=\"service-health\",service=\"$service\"}", "legendFormat": "$service"}]
    },
    {
      "id": 9, "type": "timeseries", "title": "Peticiones por segundo",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 7},
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 20, "showPoints": "never", "spanNulls": true}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum(rate(rhm_http_requests_total{service=\"$service\"}[$__rate_interval]))", "legendFormat": "$service"}]
    },
    {
      "id": 10, "type": "row", "title": "Errores y rendimiento",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14}, "collapsed": false, "panels": []
    },
    {
      "id": 11, "type": "timeseries", "title": "Tasa de errores 5xx",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "color": {"mode": "continuous-RdYlGr"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 20, "showPoints": "never", "spanNulls": true}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "single", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "100 * sum(rate(rhm_http_requests_total{service=\"$service\",status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(rhm_http_requests_total{service=\"$service\"}[$__rate_interval])), 0.001)", "legendFormat": "Errores 5xx"}]
    },
    {
      "id": 12, "type": "timeseries", "title": "Latencia promedio y P95",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never", "spanNulls": true}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "A", "expr": "sum(rate(rhm_http_request_duration_seconds_sum{service=\"$service\"}[$__rate_interval])) / clamp_min(sum(rate(rhm_http_request_duration_seconds_count{service=\"$service\"}[$__rate_interval])), 0.001)", "legendFormat": "Promedio"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(rhm_http_request_duration_seconds_bucket{service=\"$service\"}[$__rate_interval])))", "legendFormat": "P95"}
      ]
    },
    {
      "id": 13, "type": "row", "title": "Evidencia para diagnóstico",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23}, "collapsed": false, "panels": []
    },
    {
      "id": 14, "type": "logs", "title": "Logs recientes",
      "description": "Filtre por texto, nivel o traceId con la variable Buscar en logs.",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 11, "w": 14, "x": 0, "y": 24},
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true},
      "targets": [{"refId": "A", "expr": "{service=\"$service\"} |~ `(?i)$search`", "queryType": "range", "direction": "backward"}]
    },
    {
      "id": 15, "type": "table", "title": "Trazas recientes",
      "description": "Peticiones distribuidas capturadas por Jaeger. Seleccione una traza para inspeccionar sus spans.",
      "datasource": {"type": "jaeger", "uid": "jaeger"},
      "gridPos": {"h": 11, "w": 10, "x": 14, "y": 24},
      "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}}}, "overrides": []},
      "options": {"cellHeight": "sm", "showHeader": true, "footer": {"show": false}},
      "targets": [{"refId": "A", "queryType": "search", "service": "$service", "operation": "", "tags": "", "minDuration": "", "maxDuration": "", "limit": 20}]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["rhm", "observability", "diagnostic"],
  "templating": {"list": [
    {
      "name": "service", "label": "Servicio", "type": "query",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "query": {"query": "label_values(probe_success{job=\"service-health\"}, service)", "refId": "VariableQuery"},
      "definition": "label_values(probe_success{job=\"service-health\"}, service)",
      "includeAll": false, "multi": false, "refresh": 1,
      "current": {"selected": true, "text": "api-gateway", "value": "api-gateway"},
      "options": []
    },
    {
      "name": "search", "label": "Buscar en logs", "type": "textbox",
      "query": "", "current": {"selected": true, "text": "", "value": ""},
      "options": [{"selected": true, "text": "", "value": ""}]
    }
  ]},
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {"refresh_intervals": ["5s", "10s", "30s", "1m", "5m"], "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d"]},
  "timezone": "browser",
  "title": "RHM · Diagnóstico de Servicio",
  "uid": "rhm-service-detail",
  "version": 1,
  "weekStart": "monday"
}
