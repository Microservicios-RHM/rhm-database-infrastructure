DB_EMPLOYEES_NAME=employees_db
DB_EMPLOYEES_USER=employees_service
DB_EMPLOYEES_PASSWORD=employees_local_password
EMPLOYEES_LOG_LEVEL=info
CACHE_ADMIN_TOKEN=change_this_cache_admin_token

DB_DEPARTMENTS_NAME=departments_db
DB_DEPARTMENTS_USER=departments_service
DB_DEPARTMENTS_PASSWORD=departments_local_password
DB_DEPARTMENTS_ROOT_PASSWORD=departments_root_password

BROKER_USER=admin
BROKER_PASSWORD=admin
BROKER_AMQP_HOST_PORT=5672
BROKER_UI_HOST_PORT=15672
MAILHOG_UI_HOST_PORT=8025
SMTP_FROM=notificaciones@rhm.local

DB_NOTIFICATIONS_NAME=notifications_db
DB_NOTIFICATIONS_USER=notifications_service
DB_NOTIFICATIONS_PASSWORD=notifications_local_password
NOTIFICATIONS_LOG_LEVEL=info

DB_PROFILES_NAME=profiles_db
DB_PROFILES_USER=profiles_service
DB_PROFILES_PASSWORD=profiles_local_password
PROFILES_LOG_LEVEL=info

DB_VACATIONS_NAME=vacations_db
DB_VACATIONS_USER=vacations_service
DB_VACATIONS_PASSWORD=vacations_local_password
VACATIONS_LOG_LEVEL=info

# Scheduler de vacaciones. Cada minuto durante el desarrollo, para poder demostrar el ciclo
# completo sin esperar al cambio de día. Corre dentro de la única instancia del servicio:
# ver la limitación conocida en el README de ms-vacation.
VACATIONS_SCHEDULER_ENABLED=true
VACATIONS_SCHEDULER_INTERVAL_SECONDS=60

DB_AUTH_NAME=auth_db
DB_AUTH_USER=auth_service
DB_AUTH_PASSWORD=auth_local_password
AUTH_LOG_LEVEL=info

# Secreto simétrico (HMAC SHA-256) con el que auth-service firma los tokens y el api-gateway
# verifica su firma. Ambos contenedores deben recibir exactamente el mismo valor: si difieren,
# ningún token emitido será aceptado. Queda en claro aquí solo por tratarse de un entorno académico.
JWT_SECRET=change_this_jwt_secret
JWT_ISSUER=auth-service
JWT_ACCESS_TTL_SECONDS=3600
JWT_RESET_TTL_SECONDS=900

# Cuenta administradora semilla: sin ella nadie podría crear el primer empleado, porque los
# endpoints de escritura exigen rol ADMIN. Se crea al arrancar y no se sobrescribe.
ADMIN_EMPLOYEE_ID=ADMIN
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=change_admin_password
