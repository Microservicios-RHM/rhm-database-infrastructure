    {
      "name": "06 - Vacaciones",
      "item": [
        {
          "name": "Programar vacaciones",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const start = new Date();",
                  "start.setDate(start.getDate() + 30);",
                  "const end = new Date();",
                  "end.setDate(end.getDate() + 45);",
                  "const toIsoDate = (d) => d.toISOString().slice(0, 10);",
                  "",
                  "const raw = JSON.parse(pm.request.body.raw);",
                  "raw.fechaInicio = toIsoDate(start);",
                  "raw.fechaFin = toIsoDate(end);",
                  "pm.request.body.update(JSON.stringify(raw));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
