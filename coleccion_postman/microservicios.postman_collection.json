{
  "info": {
    "_postman_id": "c0f90f52-5ddf-4555-98e7-d5e37e0c9005",
    "name": "RHM - Microservicios",
    "description": "Colección para el API Gateway. Todas las solicitudes externas usan {{baseUrl}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "departmentId", "value": "" },
    { "key": "employeeId", "value": "" },
    { "key": "employeeEmail", "value": "" },
    { "key": "employeeNumber", "value": "" }
  ],
  "item": [
    {
      "name": "01 - API Gateway",
      "item": [
        {
          "name": "Health del Gateway",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/health" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Responde 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().data.status).to.eql('UP');"] } }],
          "response": []
        }
      ]
    },
    {
      "name": "02 - Departamentos",
      "item": [
        {
          "name": "Crear departamento",
          "event": [
            { "listen": "prerequest", "script": { "exec": ["pm.collectionVariables.set('departmentId', `DPT-${Date.now()}`);"] } },
            { "listen": "test", "script": { "exec": ["pm.test('Responde 201', () => pm.response.to.have.status(201));", "pm.expect(pm.response.headers.get('Location')).to.eql(`/departamentos/${pm.collectionVariables.get('departmentId')}`);"] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"id\": \"{{departmentId}}\",\n  \"nombre\": \"Departamento Postman\",\n  \"descripcion\": \"Departamento creado para validar el Gateway\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/departamentos"
          },
          "response": []
        },
        {
          "name": "Consultar departamento creado",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/departamentos/{{departmentId}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Responde 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('departmentId'));"] } }],
          "response": []
        },
        {
          "name": "Listar departamentos",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/departamentos" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Responde 200', () => pm.response.to.have.status(200));"] } }],
          "response": []
        }
      ]
    },
    {
      "name": "03 - Empleados",
      "item": [
        {
          "name": "Registrar empleado con departamento validado",
          "event": [
            { "listen": "prerequest", "script": { "exec": ["const suffix = Date.now();", "pm.collectionVariables.set('employeeId', `EMP-${suffix}`);", "pm.collectionVariables.set('employeeEmail', `empleado.${suffix}@empresa.test`);", "pm.collectionVariables.set('employeeNumber', `POSTMAN-${suffix}`);"] } },
            { "listen": "test", "script": { "exec": ["pm.test('Responde 201', () => pm.response.to.have.status(201));", "pm.expect(pm.response.headers.get('Location')).to.eql(`/empleados/${pm.collectionVariables.get('employeeId')}`);"] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"id\": \"{{employeeId}}\",\n  \"nombre\": \"Empleado\",\n  \"apellido\": \"Postman\",\n  \"email\": \"{{employeeEmail}}\",\n  \"numeroEmpleado\": \"{{employeeNumber}}\",\n  \"cargo\": \"Analista\",\n  \"area\": \"Tecnología\",\n  \"departamentoId\": \"{{departmentId}}\",\n  \"fechaIngreso\": \"2026-09-28\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/empleados"
          },
          "response": []
        },
        {
          "name": "Consultar empleado creado",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/empleados/{{employeeId}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Responde 200', () => pm.response.to.have.status(200));"] } }],
          "response": []
        },
        {
          "name": "Listar empleados",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/empleados" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Responde 200', () => pm.response.to.have.status(200));"] } }],
          "response": []
        }
      ]
    }
  ]
}
